<Window x:Class="FlixPiP.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlixPiP"
        mc:Ignorable="d"
        Title="SettingWindow" Height="258" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="ショートカット設定 (16個)" FontWeight="Bold"/>

            <TextBlock Text="ブックマーク (改行で区切り)" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBox x:Name="BookmarkTextBox" Height="145" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

            <Button Content="保存して閉じる" Click="SaveButton_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
