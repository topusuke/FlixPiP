<Window x:Class="FlixPiP.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlixPiP"
        mc:Ignorable="d"
        Title="設定" Height="300" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="ウィンドウ設定" FontSize="15" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Height="30">
                <TextBlock Text="高さ" FontSize="15" VerticalAlignment="Center" />
                <TextBox x:Name="WindowHeightTextBox" Height="20" Width="100" Margin="5,0,5,0"/>
                <TextBlock Text="横幅" FontSize="15" VerticalAlignment="Center" />
                <TextBox x:Name="WindowWidthTextBox" Height="20" Width="100"/>

            </StackPanel>

            <TextBlock Text="ブックマーク (改行で区切り)" FontSize="15" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBox x:Name="BookmarkTextBox" Height="145" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

            <Button Content="保存して閉じる" Click="SaveButton_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
